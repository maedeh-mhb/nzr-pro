# Example environment variables for this project
# Copy to .env (or use your deployment provider's secret store) and populate securely.

# Database
DATABASE_URL=postgres://user:password@host:5432/database_name

# NextAuth / Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-production-domain.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_GOOGLE_TIMEOUT_MS=30000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Your Store <no-reply@example.com>
SMTP_SECURE=false # set to "true" for TLS on port 465
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Redis (rate limiter, cache)
REDIS_URL=redis://:password@redis-host:6379

# Payment / webhooks
PAYMENT_WEBHOOK_SECRET=
# Add provider-specific secrets as needed (e.g. STRIPE_SECRET=, RAZORPAY_KEY=)

# SMS provider
SMS_API_TOKEN=
SMS_API_BASE_URL=https://api.example-sms.com
SMS_OTP_TEMPLATE_ID=

# Cron secrets for internal cron endpoints
CRON_SECRET=

# Allowed origins (CORS) - comma separated
ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# Public URLs used in emails / links
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Misc / deployment
NODE_ENV=production

# Optional: paths for headless Chrome used in PDF/invoice generation (Windows example)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Superadmin bootstrap (optional - used by scripts/create-superadmin.ts)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=ChangeMeNow123!
SUPERADMIN_NAME=Super Admin

# Notes:
# - Do NOT commit real secrets to source control. Use your hosting provider's secret store (Vercel/Netlify/Heroku/AWS Secrets Manager, etc.)
# - Remove or rotate any example credentials before deploying.
